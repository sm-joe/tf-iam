{
  "resource": {
    "aws_eks_addon": {
      "pod_identity_agent": {
        "cluster_name": "${aws_eks_cluster.this.name}",
        "addon_name": "eks-pod-identity-agent"
      },
      "ebs_csi_driver": {
        "cluster_name": "${aws_eks_cluster.this.name}",
        "addon_name": "aws-ebs-csi-driver"
      }
    },
    "aws_eks_pod_identity_association": {
      "ebs_csi": {
        "cluster_name": "${aws_eks_cluster.this.name}",
        "role_arn": "${aws_iam_role.ebs_csi_driver.arn}"
      }
    }
  }
}