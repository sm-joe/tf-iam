{
  "provider": {
    "aws": {
      "region": "us-east-1"
    }
  },
  "resource": {
    "aws_vpc": {
      "main": {
        "cidr_block": "10.60.0.0/16",
        "tags": {
          "Name": "dev-vpc"
        }
      }
    },
    "aws_subnet": {
      "public": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.60.1.0/24",
        "tags": {
          "Name": "dev-public-subnet"
        }
      },
      "private": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.60.2.0/24",
        "tags": {
          "Name": "dev-private-subnet"
        }
      }
    },
    "aws_internet_gateway": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags": {
          "Name": "dev-igw"
        }
      }
    },
    "aws_eip": {
      "nat": {
        "domain": "vpc",
        "tags": {
          "Name": "dev-nat-eip"
        }
      }
    },
    "aws_nat_gateway": {
      "main": {
        "subnet_id": "${aws_subnet.public.id}",
        "allocation_id": "${aws_eip.nat.id}",
        "tags": {
          "Name": "dev-nat"
        }
      }
    },
    "aws_route_table": {
      "public": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags": {
          "Name": "dev-public-rt"
        }
      },
      "private": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags": {
          "Name": "dev-private-rt"
        }
      }
    },
    "aws_route_table_association": {
      "public": {
        "route_table_id": "${aws_route_table.public.id}",
        "subnet_id": "${aws_subnet.public.id}"
      },
      "private": {
        "route_table_id": "${aws_route_table.private.id}",
        "subnet_id": "${aws_subnet.private.id}"
      }
    },
    "aws_security_group": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}",
        "name": "network-main",
        "tags": {
          "Name": "dev-sg"
        }
      }
    },
    "aws_network_acl": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags": {
          "Name": "dev-nacl"
        }
      }
    },
    "aws_ec2_transit_gateway": {
      "main": {
        "description": "transit",
        "tags": {
          "Name": "dev-tgw"
        }
      }
    },
    "aws_vpc_endpoint": {
      "s3": {
        "vpc_id": "${aws_vpc.main.id}",
        "service_name": "com.amazonaws.us-east-1.s3",
        "vpc_endpoint_type": "Gateway",
        "route_table_ids": [
          "${aws_route_table.public.id}",
          "${aws_route_table.private.id}"
        ],
        "tags": {
          "Name": "dev-s3-endpoint"
        }
      }
    },
    "aws_route53_zone": {
      "main": {
        "name": "example.com"
      }
    },
    "aws_route53_record": {
      "app": {
        "zone_id": "${aws_route53_zone.main.zone_id}",
        "name": "app.example.com",
        "type": "A",
        "ttl": 60,
        "records": [
          "192.0.2.10"
        ]
      }
    },
    "aws_vpc_peering_connection": {
      "peer": {
        "vpc_id": "${aws_vpc.main.id}",
        "peer_vpc_id": "${var.peer_vpc_id}",
        "peer_owner_id": "${var.peer_account_id}",
        "peer_region": "us-east-1",
        "tags": {
          "Name": "dev-peering"
        }
      }
    },
    "aws_vpn_gateway": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags": {
          "Name": "dev-vpn-gateway"
        }
      }
    }
  },
  "variable": {
    "peer_vpc_id": {
      "type": "string"
    },
    "peer_account_id": {
      "type": "string"
    }
  }
}
